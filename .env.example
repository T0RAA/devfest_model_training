# Google Cloud & Vertex AI Configuration (do not commit real secrets)
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west1
GCS_BUCKET=your-globally-unique-ucsc-wildlife-bucket
GCS_PREFIX=ucsc-wildlife

# Gemini 4 Argon Integration (Google Gen AI SDK / Vertex AI)
GEMINI_MODEL=gemini-4-argon
USE_VERTEX_AI=true
GOOGLE_API_KEY=

# iNaturalist API Configuration (respect 1 req/s, 10k req/day limits)
INAT_USER_AGENT=UCSC-Wildlife-Vision/2.1 (academic-research; contact=hranjan@ucsc.edu)
INAT_CAMPUS_PLACE_ID=3519
INAT_CAMPUS_BROAD_PLACE_ID=94596

# Application & Model Runtime Settings
WILDLIFE_MODEL_VERSION=species-v2.0
WILDLIFE_DETECTOR_VERSION=md6-apa-rtdetr-e
WILDLIFE_CROP_VERSION=crop-v1
WILDLIFE_CALIBRATION_VERSION=temp-v2
WILDLIFE_RATING_VERSION=quality-v2
WILDLIFE_CHECKPOINT_PATH=
WILDLIFE_MAX_UPLOAD_BYTES=10485760
WILDLIFE_MAX_IMAGE_PIXELS=25000000
WILDLIFE_FEEDBACK_QUEUE_PATH=data/manifests/feedback_queue.jsonl
